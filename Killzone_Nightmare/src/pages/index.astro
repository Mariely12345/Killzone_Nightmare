---
import Layout from "../layouts/Layout.astro";
import Portada from "../components/Portada.astro";
import Hero from "../components/Hero.astro";
import IntroSection from "../components/IntroSection.astro";
import Characters from "../components/Characters.astro";
import Gameplay from "../components/Gameplay.astro";
---

<Layout title="Killzone Nightmare | Inicio">
  <div class="page">
    <Portada />
    <IntroSection />
    <Hero />
    <Characters />
    <Gameplay />
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 6vw, 5rem);  /* espacio entre secciones */
  }
</style>