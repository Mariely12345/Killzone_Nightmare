---
interface Props {
  src: string;
  alt: string;
  rot?: string;
  delay?: string;
  tapes?: Array<"top" | "tl" | "tr" | "bl" | "br">;
  style?: string; // posición: "top:0; right:0; width:78%"
}

const { src, alt, rot = "0deg", delay = "0s", tapes = ["top"], style = "" } = Astro.props;
---

<figure class="photo" data-stick style={`--rot:${rot}; --delay:${delay}; ${style}`}>
  <!-- Capa 1: papel de fondo -->
  <div class="photo-paper"></div>

  <!-- Capa 2: la imagen encima -->
  <div class="slot">
    <img src={src} alt={alt} loading="lazy" onerror="this.style.display='none'" />
  </div>

  <!-- Cinta -->
  {tapes.map((pos) => <span class={`tape tape-${pos}`} aria-hidden="true" />)}
</figure>

<style>
  .photo {
    position: absolute;
    aspect-ratio: 4 / 3;
  }

  .photo-paper {
    position: absolute;
    inset: 0;
    background:
      url("/images/paper/photo-paper.png") center / 150% 150% no-repeat;
    /* Borde rasgado de respaldo. Si tu PNG ya trae bordes rasgados, borra esta línea. */
    clip-path: polygon(
      0% 2%, 10% 0%, 25% 1.5%, 42% 0%, 60% 1.5%, 78% 0%, 92% 1.5%, 100% 0.5%,
      99% 25%, 100% 50%, 99% 75%, 100% 98%, 85% 100%, 65% 98.5%, 45% 100%,
      25% 98.5%, 10% 100%, 0% 98%, 1% 70%, 0% 45%, 1% 20%
    );
  }

  .slot {
    position: absolute;
    inset: 7% 6% 9% 6%;
    background: radial-gradient(ellipse at 70% 30%, #4a2380, #1a0b2e 70%);
    overflow: hidden;
  }
  .slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---------- Cinta ---------- */
  .tape {
    position: absolute;
    z-index: 3;
    width: 34%;
    height: 28px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.6), rgba(235, 235, 225, 0.35));
    border-top: 1px solid rgba(255, 255, 255, 0.5);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    /* Extremos dentados como cinta cortada */
    clip-path: polygon(
      0% 0%, 3% 15%, 0% 30%, 3% 45%, 0% 60%, 3% 75%, 0% 90%, 2% 100%,
      100% 100%, 97% 85%, 100% 70%, 97% 55%, 100% 40%, 97% 25%, 100% 10%, 98% 0%
    );
  }
  .tape-top { left: 33%; top: -14px; rotate: -3deg; }
  .tape-tl  { left: -7%; top: 4px;   rotate: -38deg; width: 30%; }
  .tape-tr  { right: -7%; top: 4px;  rotate: 38deg;  width: 30%; }
  .tape-bl  { left: -7%; bottom: 4px; rotate: 38deg;  width: 30%; }
  .tape-br  { right: -7%; bottom: 4px; rotate: -38deg; width: 30%; }
</style>