---
interface Props {
  src: string;
  alt: string;
  rot?: string;
  delay?: string;
  tapes?: Array<"top" | "tl" | "tr" | "bl" | "br">;
  style?: string; // posición: "top:0; right:0; width:78%"
}

const { src, alt, rot = "0deg", delay = "0s", tapes = ["top"], style = "" } = Astro.props;
---

<figure class="photo" data-stick style={`--rot:${rot}; --delay:${delay}; ${style}`}>
  <!-- Capa 1: papel de fondo -->
  <div class="photo-paper"></div>

  <!-- Capa 2: la imagen encima (con bordes rasgados) -->
  <div class="slot">
    <img src={src} alt={alt} loading="lazy" onerror="this.style.display='none'" />
  </div>

  <!-- Cintas -->
  {tapes.map((pos) => (
    <img
      class={`tape tape-${pos}`}
      src="/images/tape/tape.png"
      alt=""
      aria-hidden="true"
      loading="lazy"
      onerror="this.style.display='none'"
    />
  ))}
</figure>

<style>
  .photo {
    position: absolute;
    aspect-ratio: 4 / 3;
  }

  .photo-paper {
    position: absolute;
    inset: 0;
    background:
      url("/images/paper/photo-paper.png") center / 100% 100% no-repeat,
      #efe6d0;
    /* Tono crema envejecido (no blanco). Sube sepia si lo quieres más oscuro */
    filter: sepia(0.25) saturate(0.9) brightness(0.97);
    clip-path: polygon(
      0% 2%, 10% 0%, 25% 1.5%, 42% 0%, 60% 1.5%, 78% 0%, 92% 1.5%, 100% 0.5%,
      99% 25%, 100% 50%, 99% 75%, 100% 98%, 85% 100%, 65% 98.5%, 45% 100%,
      25% 98.5%, 10% 100%, 0% 98%, 1% 70%, 0% 45%, 1% 20%
    );
  }

  .slot {
    position: absolute;
    inset: 7% 6% 9% 6%;
    background: radial-gradient(ellipse at 70% 30%, #4a2380, #1a0b2e 70%);
    overflow: hidden;
    /* Borde superior e inferior rasgados */
    clip-path: polygon(
      0% 3%, 8% 0%, 16% 2.5%, 27% 0.5%, 38% 3%, 50% 1%, 62% 3.5%, 74% 0.5%, 86% 3%, 100% 1%,
      100% 97%, 88% 100%, 76% 96.5%, 63% 99.5%, 50% 96%, 37% 99%, 24% 96.5%, 12% 100%, 0% 97%
    );
  }
  .slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---------- Cinta ---------- */
  .tape {
    position: absolute;
    z-index: 3;
    width: 32%;
    height: auto;
    max-width: none;
    opacity: 0.6; /* translúcida. Si aún se ve gris/opaca, baja a 0.45 */
    pointer-events: none;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
  }

  /* Cruzan el borde del papel: mitad sobre la foto, mitad fuera */
  .tape-top { left: 30%;   top: -6%;    width: 38%; rotate: -2deg; }
  .tape-tl  { left: -10%;  top: -2%;    rotate: -38deg; }
  .tape-tr  { right: -10%; top: -2%;    rotate: 38deg; }
  .tape-bl  { left: -10%;  bottom: 1%;  rotate: 36deg; }
  .tape-br  { right: -10%; bottom: 1%;  rotate: -36deg; }
</style>