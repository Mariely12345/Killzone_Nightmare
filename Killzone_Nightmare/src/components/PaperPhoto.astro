---
interface Props {
  src: string;
  alt: string;
  rot?: string;
  delay?: string;
  style?: string; // posición: "top:0; right:0; width:78%"
}

const { src, alt, rot = "0deg", delay = "0s", style = "" } = Astro.props;
---

<figure class="photo" data-stick style={`--rot:${rot}; --delay:${delay}; ${style}`}>
  <!-- Capa 1: papel de fondo (solo tu PNG, sin color ni recorte hechos con CSS) -->
  <div class="photo-paper"></div>

  <!-- Capa 2: la imagen encima (con bordes rasgados) -->
  <div class="slot">
    <img src={src} alt={alt} loading="lazy" onerror="this.style.display='none'" />
  </div>
</figure>

<style>
  .photo {
    position: absolute;
    aspect-ratio: 4 / 3;
  }

  .photo-paper {
    position: absolute;
    inset: 0;
    background: url("/images/paper/photo-paper.png") center / 140% 140% no-repeat;
  }

  .slot {
    position: absolute;
    inset: 7% 6% 9% 6%;
    background: radial-gradient(ellipse at 70% 30%, #4a2380, #1a0b2e 70%);
    overflow: hidden;
    /* Borde superior e inferior rasgados */
    clip-path: polygon(
      0% 3%, 8% 0%, 16% 2.5%, 27% 0.5%, 38% 3%, 50% 1%, 62% 3.5%, 74% 0.5%, 86% 3%, 100% 1%,
      100% 97%, 88% 100%, 76% 96.5%, 63% 99.5%, 50% 96%, 37% 99%, 24% 96.5%, 12% 100%, 0% 97%
    );
  }
  .slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>