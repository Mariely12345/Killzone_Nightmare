---
import Pin from "./Pin.astro";
import PaperPhoto from "./PaperPhoto.astro";
import Tape from "./Tape.astro";
---

<section class="intro" id="juego">
  <!-- Tarjeta de descripción -->
  <div class="note" data-stick style="--rot:-2deg; --delay:0s;">
    <div class="note-bg"></div>

    <div class="note-body">
      <img
        class="skull"
        src="/images/intro/skull.png"
        alt=""
        aria-hidden="true"
        onerror="this.style.display='none'"
      />

      <h2>¿De qué trata?</h2>
      <p>
        Nuestro proyecto consiste en un shooter multijugador con elementos de terror, que combina la acción y la estrategia de un juego de disparos con situaciones inesperadas de <span class="hl">tensión </span> y <span class="hl">sobresaltos</span>.
      </p>
      <a class="more" href="/historia">Conoce la Historia →</a>
    </div>

    <!-- Pines en las 4 esquinas de la tarjeta.
         x / y = dónde cae la PUNTA, respecto a la tarjeta. -->
    <Pin color="red"    x="8%"  y="12%"  size={82} />
    <Pin color="blue"   x="91%" y="15%"  size={82} />
    <Pin color="yellow" x="90%" y="96%" size={82} />
    <Pin color="green"  x="8%"  y="96%" size={82} />
  </div>

  <!-- Dos fotos. Las cintas van en una capa aparte, por encima de ambas.
       x / y / w son % de esta caja; cambia rot para girarlas. -->
  <div class="photos">
    <PaperPhoto
      src="/images/galeria/img-11.jpeg"
      alt="Captura de Killzone Nightmare: combate en una estación abandonada"
      rot="3deg"
      delay="0.3s"
      style="top:0; right:0; width:78%;"
    />
    <PaperPhoto
      src="/images/galeria/img-10.jpeg"
      alt="Captura de Killzone Nightmare: mansión en ruinas"
      rot="-4deg"
      delay="0.6s"
      style="bottom:0; left:2%; width:78%;"
    />

    <Tape x="46%" y="-3%" w="35%" rot="5deg" delay="0.6s" />  <!-- arriba de la foto 1 -->
    <Tape x="-10%" y="46%" w="35%" rot="-30deg" delay="0.9s" />  <!-- une foto 1 y foto 2, a la izquierda -->
    <Tape x="58%" y="40%" w="35%" rot="30deg" delay="1.1s" />  <!-- esquina derecha de la foto 2 -->
  </div>
</section>

<style>
  /*
  .intro {
    width: min(1200px, 94%);
    margin: 4.5rem auto 0;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3rem;
    align-items: center;
  }*/

  .intro {
    width: min(1200px, 94%);
    margin: 0 auto;            /* antes: 4.5rem auto 0 */
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  /* ---------- Tarjeta ---------- */
  .note { position: relative; }

  .note-bg {
    position: absolute;
    inset: 0;
    background:
      url("/images/paper/paper-card.png") center / 125% 125% no-repeat;

    /* Borde rasgado de respaldo. Si tu PNG ya trae bordes rasgados, borra esta línea. */
    clip-path: polygon(
      1% 2%, 12% 0.5%, 25% 1.5%, 40% 0%, 55% 1.2%, 70% 0%, 85% 1.5%, 99% 0.5%,
      100% 15%, 99% 35%, 100% 55%, 99% 75%, 100% 98%, 85% 100%, 70% 98.8%,
      55% 100%, 40% 99%, 25% 100%, 12% 98.5%, 0% 100%, 1% 75%, 0% 55%, 1% 35%, 0% 15%
    );
  }

  .note-body {
    position: relative;
    z-index: 2;
    padding: 3.2rem 3rem 2.8rem;
  }

  .skull {
    position: absolute;
    top: 1.4rem;
    right: 3.4rem;
    width: clamp(64px, 8vw, 96px);
    height: auto;
    rotate: 5deg;
    opacity: 0.8;
    mix-blend-mode: multiply; /* se funde con la textura del papel */
    pointer-events: none;
  }

  h2 {
    font-family: var(--font-title);
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    color: var(--purple);
    margin-bottom: 0.8rem;
    max-width: 80%;
  }

  p {
    font-size: 1.1rem;
    line-height: 1.75;
  }
  .hl { color: var(--purple); font-weight: 700; }

  .more {
    display: inline-block;
    margin-top: 1.4rem;
    padding: 0.55rem 1.4rem;
    font-weight: 700;
    color: var(--purple);
    border: 2px solid var(--purple);
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }
  .more:hover { background: var(--purple); color: #fff; }

  /* ---------- Fotos ---------- */
  .photos {
    position: relative;
    isolation: isolate; /* las cintas quedan por encima de las fotos pero no del header */
    aspect-ratio: 1 / 1.05;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .intro { grid-template-columns: 1fr; gap: 2.5rem; }
    .note-body { padding: 2.6rem 1.8rem 2.2rem; }
    h2 { max-width: 70%; }
    .skull { width: 50px; right: 2.4rem; }
  }
</style>