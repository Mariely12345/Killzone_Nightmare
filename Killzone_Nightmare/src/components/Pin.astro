---
interface Props {
  color?: "red" | "blue" | "green" | "yellow";
  size?: number;  // ancho en px (en móvil se reduce solo)
  x?: string;     // dónde cae la PUNTA, horizontal: "5%"
  y?: string;     // dónde cae la PUNTA, vertical: "8%"
  rot?: string;
}

const { color = "red", size = 92, x = "0%", y = "0%", rot = "0deg" } = Astro.props;

// Posición de la PUNTA dentro de cada PNG (en píxeles del archivo original).
// Solo importan las proporciones. Si una punta no cae justo donde quieres,
// ajusta tipX / tipY de ese color.
const pins = {
  red:    { w: 1280, tipX: 900, tipY: 1060 },
  blue:   { w: 1220, tipX: 420, tipY: 1090 },
  green:  { w: 1220, tipX: 935, tipY: 1100 },
  yellow: { w: 1220, tipX: 400, tipY: 1090 },
};

const p = pins[color];
const fx = (p.tipX / p.w).toFixed(3);
const fy = (p.tipY / p.w).toFixed(3);
---

<span
  class="pin"
  style={`left:${x}; top:${y}; rotate:${rot}; --s:${size}px;`}
  aria-hidden="true"
>
  <img
    src={`/images/pins/pin-${color}.png`}
    alt=""
    loading="lazy"
    style={`left:calc(var(--size) * -${fx}); top:calc(var(--size) * -${fy});`}
    onerror="this.style.display='none'"
  />
</span>

<style>
  /* El span mide 0×0 y es el "ancla": la punta del pincho queda exactamente aquí */
  .pin {
    --size: var(--s);
    position: absolute;
    z-index: 5;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .pin img {
    position: absolute;
    width: var(--size);
    height: auto;
    max-width: none; /* importante: el contenedor mide 0, sin esto la imagen se aplasta */
    filter: drop-shadow(0 3px 3px rgba(0, 0, 0, 0.45));
  }

  @media (max-width: 700px) {
    .pin { --size: calc(var(--s) * 0.7); }
  }
</style>