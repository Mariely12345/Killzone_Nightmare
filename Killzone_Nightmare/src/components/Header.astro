---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/historia", label: "Historia" },
  { href: "/historia#personajes", label: "Personajes" },
  { href: "/jugabilidad", label: "Jugabilidad" },
  { href: "/galeria", label: "Galería" },
  /*{ href: "/noticias", label: "Noticias" }, */
  /* { href: "/descargar", label: "Descargar" }, */
];

const socials = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/osmac_games/",
    path: "M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3Z",
  },
  {
    name: "TikTok",
    href: "https://www.tiktok.com/@osmac_games",
    path: "M16.6 5.82s.51.5 0 0A4.278 4.278 0 0 1 15.54 3h-3.09v12.4a2.592 2.592 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48Z",
  },
  {
    name: "X",
    href: "https://x.com/OSMAC_GAMES",
    path: "M18.2 2.2h3.3l-7.2 8.3 8.5 11.3h-6.7l-5.2-6.9-6 6.9H1.6l7.7-8.8L1.2 2.2H8l4.7 6.3 5.5-6.3zm-1.2 17.6h1.8L7.1 4.1H5.1l11.9 15.7z",
  },
];

const isActive = (href: string) => !href.includes("#") && pathname === href;
---

<header class="header" id="site-header">
  <a href="/" class="logo" aria-label="Killzone Nightmare - Inicio">
    <img src="/images/logo.png" alt="OSMAC Games" width="140" height="56" />
  </a>

  <button
    class="menu-toggle"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="nav"
  >
    <span></span><span></span><span></span>
  </button>

  <nav class="nav" id="nav" aria-label="Principal">
    <ul>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={["nav-link", { active: isActive(l.href) }]}
            aria-current={isActive(l.href) ? "page" : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="socials">
    {socials.map((s) => (
      <a href={s.href} aria-label={s.name} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={s.path} />
        </svg>
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.getElementById("nav");

  const setOpen = (open: boolean) => {
    nav?.classList.toggle("open", open);
    btn?.setAttribute("aria-expanded", String(open));
    btn?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };

  btn?.addEventListener("click", () => setOpen(!nav?.classList.contains("open")));

  // Cierra el menú al elegir un link o al presionar Escape
  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setOpen(false))
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>

<style>
  .header {
    /* Paleta local: usa tus variables si ya existen */
    --ink: #2b1608;
    --blood: #8b1a1a;
    --paper-solid: var(--paper, #e8d3ab);

    position: sticky;
    top: 0;
    z-index: 50;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;

    width: min(1200px, 96%);
    height: 160px;
    margin: 0.5rem auto 0;
    /* Deja libres las puntas del papel rasgado */
    padding: 0 4.5rem;

    /* Sin color de fondo ni border-radius: la forma la da el PNG */
    background: url("/images/paper-header.png") center / 100% 100% no-repeat;
    /* La sombra sigue la transparencia del PNG (bordes rotos) */
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.5));

    /* Un solo momento de movimiento: el papel cae al cargar */
    animation: header-drop 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes header-drop {
    from {
      opacity: 0;
      transform: translateY(-24px) rotate(-0.6deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .logo img {
    height: 76px;
    width: auto;
    transition: transform 0.25s ease;
  }
  .logo:hover img {
    transform: rotate(-2deg) scale(1.04);
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.4rem;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.35rem 0.3rem;
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  /* Subrayado tipo pincelada que crece desde la izquierda */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--blood);
    border-radius: 2px 6px 2px 5px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--blood);
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .socials {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }
  .socials a {
    color: var(--ink);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .socials a:hover {
    color: var(--blood);
    transform: translateY(-2px) rotate(-5deg);
  }
  .socials svg {
    display: block;
    width: 26px;
    height: 26px;
  }

  /* Foco visible para teclado */
  .header a:focus-visible,
  .menu-toggle:focus-visible {
    outline: 2px solid var(--blood);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
  }
  .menu-toggle span {
    width: 26px;
    height: 3px;
    background: var(--ink);
    border-radius: 2px;
  }

  /* Pantallas medianas: compacta el menú */
  @media (max-width: 1100px) {
    .header { padding: 0 3.5rem; }
    .nav ul { gap: 0.8rem; }
    .nav-link { font-size: 0.9rem; }
  }

  /* Móvil / tablet: menú hamburguesa */
  @media (max-width: 900px) {
    .header {
      height: 96px;
      padding: 0 2.5rem;
    }
    .logo img { height: 60px; }
    .menu-toggle { display: flex; }
    .socials { display: none; }

    .nav {
      display: none;
      position: absolute;
      top: calc(100% - 6px);
      left: 5%;
      right: 5%;
      padding: 1.2rem 1.5rem 1.8rem;
      background: var(--paper-solid);
      /* Borde inferior rasgado */
      clip-path: polygon(
        0 0, 100% 0, 100% 92%,
        94% 96%, 88% 91%, 80% 97%, 72% 92%, 64% 98%, 55% 93%,
        46% 97%, 37% 92%, 28% 98%, 19% 93%, 10% 97%, 4% 92%, 0 95%
      );
    }
    .nav.open { display: block; }
    .nav ul {
      flex-direction: column;
      gap: 0.4rem;
    }
    .nav-link {
      display: block;
      padding: 0.6rem 0.4rem;
      font-size: 1.05rem;
    }
    .nav-link::after { display: none; }
    .nav-link.active { text-decoration: underline; text-decoration-color: var(--blood); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  }

  @media (max-width: 480px) {
    .header { padding: 0 1.8rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .header { animation: none; }
    .nav-link::after,
    .socials a,
    .logo img { transition: none; }
  }
</style>