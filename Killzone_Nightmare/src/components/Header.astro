---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/historia", label: "Historia" },
  { href: "/historia#personajes", label: "Personajes" },
  { href: "/jugabilidad", label: "Jugabilidad" },
  { href: "/galeria", label: "Galería" },
  { href: "/noticias", label: "Noticias" },
  { href: "/descargar", label: "Descargar" },
];

const socials = [
  {
    name: "YouTube",
    href: "#",
    path: "M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z",
  },
  {
    name: "Discord",
    href: "#",
    path: "M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.2.5a18 18 0 0 0-6.4 0L8.6 3a19.8 19.8 0 0 0-4.9 1.4C.6 9 0 13.5.3 18a19.9 19.9 0 0 0 6 3l.9-1.4c-.5-.2-1-.5-1.5-.8l.4-.3a14.2 14.2 0 0 0 12.2 0l.4.3c-.5.3-1 .6-1.5.8l.9 1.4a19.9 19.9 0 0 0 6-3c.4-5.2-.7-9.7-3.4-13.6zM8.5 15.3c-1.2 0-2.1-1.1-2.1-2.4s.9-2.4 2.1-2.4 2.1 1.1 2.1 2.4-.9 2.4-2.1 2.4zm7 0c-1.2 0-2.1-1.1-2.1-2.4s.9-2.4 2.1-2.4 2.1 1.1 2.1 2.4-.9 2.4-2.1 2.4z",
  },
  {
    name: "X",
    href: "#",
    path: "M18.2 2.2h3.3l-7.2 8.300 8.500 11.300h-6.700l-5.200-6.900-6 6.900H1.600l7.700-8.800L1.200 2.200H8l4.700 6.300 5.500-6.300zm-1.200 17.600h1.800L7.100 4.100H5.100l11.900 15.700z",
  },
];

const isActive = (href: string) => !href.includes("#") && pathname === href;
---

<header class="header" id="site-header">
  <a href="/" class="logo" aria-label="Killzone Nightmare - Inicio">
    <img src="/images/logo.png" alt="OSMAC Games" width="140" height="56" />
  </a>

  <button
    class="menu-toggle"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="nav"
  >
    <span></span><span></span><span></span>
  </button>

  <nav class="nav" id="nav" aria-label="Principal">
    <ul>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={["nav-link", { active: isActive(l.href) }]}
            aria-current={isActive(l.href) ? "page" : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="socials">
    {socials.map((s) => (
      <a href={s.href} aria-label={s.name} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={s.path} />
        </svg>
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.getElementById("nav");

  const setOpen = (open: boolean) => {
    nav?.classList.toggle("open", open);
    btn?.setAttribute("aria-expanded", String(open));
    btn?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };

  btn?.addEventListener("click", () => setOpen(!nav?.classList.contains("open")));

  // Cierra el menú al elegir un link o al presionar Escape
  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setOpen(false))
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>

<style>
  .header {
    /* Paleta local: usa tus variables si ya existen */
    --ink: #2b1608;
    --blood: #8b1a1a;
    --paper-solid: var(--paper, #e8d3ab);

    position: sticky;
    top: 0;
    z-index: 50;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;

    width: min(1200px, 96%);
    height: 160px;
    margin: 0.5rem auto 0;
    /* Deja libres las puntas del papel rasgado */
    padding: 0 4.5rem;

    /* Sin color de fondo ni border-radius: la forma la da el PNG */
    background: url("/images/paper-header.png") center / 100% 100% no-repeat;
    /* La sombra sigue la transparencia del PNG (bordes rotos) */
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.5));

    /* Un solo momento de movimiento: el papel cae al cargar */
    animation: header-drop 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes header-drop {
    from {
      opacity: 0;
      transform: translateY(-24px) rotate(-0.6deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .logo img {
    height: 76px;
    width: auto;
    transition: transform 0.25s ease;
  }
  .logo:hover img {
    transform: rotate(-2deg) scale(1.04);
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.4rem;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.35rem 0.3rem;
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  /* Subrayado tipo pincelada que crece desde la izquierda */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--blood);
    border-radius: 2px 6px 2px 5px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--blood);
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .socials {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }
  .socials a {
    color: var(--ink);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .socials a:hover {
    color: var(--blood);
    transform: translateY(-2px) rotate(-5deg);
  }
  .socials svg {
    display: block;
    width: 26px;
    height: 26px;
  }

  /* Foco visible para teclado */
  .header a:focus-visible,
  .menu-toggle:focus-visible {
    outline: 2px solid var(--blood);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
  }
  .menu-toggle span {
    width: 26px;
    height: 3px;
    background: var(--ink);
    border-radius: 2px;
  }

  /* Pantallas medianas: compacta el menú */
  @media (max-width: 1100px) {
    .header { padding: 0 3.5rem; }
    .nav ul { gap: 0.8rem; }
    .nav-link { font-size: 0.9rem; }
  }

  /* Móvil / tablet: menú hamburguesa */
  @media (max-width: 900px) {
    .header {
      height: 96px;
      padding: 0 2.5rem;
    }
    .logo img { height: 60px; }
    .menu-toggle { display: flex; }
    .socials { display: none; }

    .nav {
      display: none;
      position: absolute;
      top: calc(100% - 6px);
      left: 5%;
      right: 5%;
      padding: 1.2rem 1.5rem 1.8rem;
      background: var(--paper-solid);
      /* Borde inferior rasgado */
      clip-path: polygon(
        0 0, 100% 0, 100% 92%,
        94% 96%, 88% 91%, 80% 97%, 72% 92%, 64% 98%, 55% 93%,
        46% 97%, 37% 92%, 28% 98%, 19% 93%, 10% 97%, 4% 92%, 0 95%
      );
    }
    .nav.open { display: block; }
    .nav ul {
      flex-direction: column;
      gap: 0.4rem;
    }
    .nav-link {
      display: block;
      padding: 0.6rem 0.4rem;
      font-size: 1.05rem;
    }
    .nav-link::after { display: none; }
    .nav-link.active { text-decoration: underline; text-decoration-color: var(--blood); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  }

  @media (max-width: 480px) {
    .header { padding: 0 1.8rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .header { animation: none; }
    .nav-link::after,
    .socials a,
    .logo img { transition: none; }
  }
</style>