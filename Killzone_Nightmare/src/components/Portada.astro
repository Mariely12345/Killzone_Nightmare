---
// ===== Edita aquí =====
const releaseISO = "2026-11-19T10:00:00-06:00"; // fecha y hora del estreno (hora de Nuevo León)
const releaseLabel = "Jueves 19 de Noviembre del 2026 • 10:00 AM";

const cards = [
  { href: "/historia",   title: "Historia y Mapa", image: "/images/historia/mapa-02.jpeg",    rot: "2deg",  delay: "0.5s" },
  { href: "#personajes", title: "Personajes",      image: "/images/portada/foto-personajes.png", rot: "-2deg", delay: "0.8s" },
];
---

<section class="portada" aria-label="Portada de Killzone Nightmare">
  <div class="stage">
    <!-- Fondo con bordes rasgados -->
<div class="frame-shadow" aria-hidden="true">
  <div class="frame">
    <!-- Tu imagen de fondo de la calabaza/escenario -->
    <video class="bg" src="/images/portada/fondo.mp4" autoplay muted loop playsinline></video>
    <div class="shade"></div>
    
    {/* AQUÍ AGREGAS LA IMAGEN DEL PAPEL RASGADO REAL ENCIMA O COMO MÁSCARA */}
    <img class="torn-paper-border" src="/images/portada/papel-rasgado-real.png" alt="" aria-hidden="true" />
  </div>
</div>

    <!-- Contador -->
    <div
      class="countdown"
      data-stick
      style="--rot:-1deg; --delay:0s;"
      data-release={releaseISO}
      data-label={releaseLabel}
    >
      <p class="cd-label">{releaseLabel}</p>
      <div class="cd-grid" role="timer" aria-label="Cuenta regresiva al estreno">
        <div class="cd-unit"><span data-unit="days">00</span><small>Días</small></div>
        <div class="cd-unit"><span data-unit="hours">00</span><small>Horas</small></div>
        <div class="cd-unit"><span data-unit="minutes">00</span><small>Minutos</small></div>
        <div class="cd-unit"><span data-unit="seconds">00</span><small>Segundos</small></div>
      </div>
    </div>

    <!-- Sello "Proyecto escolar" -->
    <div class="stamp-paper" data-stick style="--rot:3deg; --delay:0.3s;">
      <svg class="stamp" viewBox="0 0 200 200" role="img" aria-label="Proyecto escolar 2026">
        <!--<circle cx="100" cy="100" r="92" fill="none" stroke="currentColor" stroke-width="6" />
        <circle cx="100" cy="100" r="80" fill="none" stroke="currentColor" stroke-width="2" />
        <g transform="rotate(-14 100 100)" fill="currentColor" font-family="Lora, serif" font-weight="700" text-anchor="middle">
          <text x="100" y="84" font-size="25">PROYECTO</text>
          <text x="100" y="116" font-size="25">ESCOLAR</text>
          <text x="100" y="142" font-size="16">• 2026 •</text>
        </g> -->
      </svg>
    </div>

    <!-- Centro: logo, lema y botón -->
    <div class="center">
      <h1 class="logo">
        <img src="/images/logo2.png" alt="Killzone Nightmare" onerror="this.style.display='none'" />
      </h1>
      <p class="tagline">Descubre este mundo desconocido.</p>
      <a class="btn-trailer" href="/galeria#trailer">Ver tráiler</a>
    </div>

    <a class="explore" href="#juego">Explorar proyecto</a>

    <!-- Tarjetas laterales -->
    <nav class="cards" aria-label="Accesos rápidos">
      {cards.map((c) => (
        <a class="polaroid" href={c.href} data-stick style={`--rot:${c.rot}; --delay:${c.delay};`}>
          <span class="ph-img">
            <img src={c.image} alt="" loading="lazy" onerror="this.style.display='none'" />
          </span>
          <span class="ph-cap">{c.title}</span>
          <img class="strip strip-l" src="/images/tape/tape.png" alt="" aria-hidden="true" onerror="this.style.display='none'" />
          <img class="strip strip-r" src="/images/tape/tape.png" alt="" aria-hidden="true" onerror="this.style.display='none'" />
        </a>
      ))}
    </nav>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>(".countdown");

  if (root) {
    const target = new Date(root.dataset.release ?? "").getTime();
    const label = root.querySelector<HTMLElement>(".cd-label");
    const el = {
      days: root.querySelector<HTMLElement>('[data-unit="days"]'),
      hours: root.querySelector<HTMLElement>('[data-unit="hours"]'),
      minutes: root.querySelector<HTMLElement>('[data-unit="minutes"]'),
      seconds: root.querySelector<HTMLElement>('[data-unit="seconds"]'),
    };
    const pad = (n: number) => String(n).padStart(2, "0");

    function tick() {
      let diff = Math.max(0, target - Date.now());
      if (Number.isNaN(target)) diff = 0;

      const days = Math.floor(diff / 86_400_000);
      const hours = Math.floor((diff % 86_400_000) / 3_600_000);
      const minutes = Math.floor((diff % 3_600_000) / 60_000);
      const seconds = Math.floor((diff % 60_000) / 1000);

      if (el.days) el.days.textContent = pad(days);
      if (el.hours) el.hours.textContent = pad(hours);
      if (el.minutes) el.minutes.textContent = pad(minutes);
      if (el.seconds) el.seconds.textContent = pad(seconds);

      if (diff === 0) {
        if (label && root) label.textContent = root.dataset.released ?? "";
        window.clearInterval(timer);
      }
    }

    const timer = window.setInterval(tick, 1000);
    tick();
  }
</script>

<style>
  .portada {
    width: min(1500px, 97%);
    margin: 1.2rem auto 0;
  }

  .stage {
    position: relative;
    aspect-ratio: 16 / 8.4;
    min-height: 580px;
  }

  /* ---------- Fondo ---------- */
  .frame-shadow {
    position: absolute;
    inset: 0;
    filter: drop-shadow(0 10px 14px rgba(0, 0, 0, 0.55));
  }
  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 35%, #2c3a52 0%, #141a28 55%, #07090f 100%);
    clip-path: polygon(
      0% 3%, 2% 0.8%, 5% 2.5%, 9% 0%, 14% 2%, 20% 0.5%, 27% 2.5%, 34% 1%, 41% 2.2%,
      48% 0%, 55% 1.8%, 62% 0.5%, 70% 2.5%, 78% 1%, 85% 2.2%, 92% 0.5%, 96% 2%, 100% 0%,
      100% 96.5%, 97% 99%, 92% 97.5%, 86% 100%, 79% 98%, 71% 99.5%, 63% 97.5%, 55% 100%,
      47% 98%, 39% 99.5%, 30% 97.5%, 22% 100%, 14% 98%, 7% 99.5%, 0% 97%
    );
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 45%, rgba(0, 0, 0, 0.55) 100%);
  }

  /* ---------- Contador ---------- */
  .countdown {
    position: absolute;
    top: 4.5%;
    left: 0;
    right: 0;
    margin-inline: auto;
    width: min(640px, 44%);
    padding: 1.4rem 1.6rem 1.8rem;
    text-align: center;
    color: #7d1a1a;
    background:
      url("/images/portada/papel-contador.png") center / 115% 115% no-repeat,
     /* #dcc08c;
    clip-path: polygon(
      1% 6%, 8% 0%, 20% 4%, 35% 0%, 50% 3%, 66% 0%, 82% 4%, 94% 0%, 100% 5%,
      99% 40%, 100% 70%, 98% 92%, 90% 100%, 76% 96%, 60% 100%, 44% 96%, 28% 100%,
      12% 96%, 2% 100%, 0% 70%, 1% 40%
    );
    z-index: 3; */
  }
  .cd-label {
    font-weight: 700;
    font-size: clamp(0.8rem, 1.25vw, 1.1rem);
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .cd-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .cd-unit + .cd-unit { border-left: 2px solid rgba(43, 29, 18, 0.55); }
  .cd-unit span {
    display: block;
    font-weight: 700;
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .cd-unit small {
    font-size: clamp(0.65rem, 0.95vw, 0.85rem);
    text-transform: uppercase;
    color: var(--ink);
    font-weight: 600;
  }

  /* ---------- Sello ---------- */
  .stamp-paper {
    position: absolute;
    top: 2.5%;
    right: 1%;
    width: clamp(130px, 14vw, 210px);
    aspect-ratio: 1 / 1.1;
    display: grid;
    place-items: center;
    background:
      url("/images/portada/papel-sello.png") center / 100% 90% no-repeat,
   /*   #d9bd86;
    clip-path: polygon(
      4% 8%, 30% 0%, 55% 4%, 80% 0%, 100% 6%,
      97% 35%, 100% 60%, 96% 100%, 70% 95%, 45% 100%, 20% 96%, 0% 100%, 3% 60%, 0% 30%
    );
    z-index: 3; */
  }
  .stamp {
    width: 84%;
    color: #4a1c1c;
    opacity: 0.85;
    mix-blend-mode: multiply;
  }

  /* ---------- Centro ---------- */
  .center {
    position: absolute;
    inset: 0;
    padding-top: 9%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    pointer-events: none;
    z-index: 2;
  }
  .center > * { pointer-events: auto; }

  .logo img {
    width: min(46vw, 560px);
    height: auto;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.7));
  }
  .tagline {
    font-size: clamp(1rem, 2vw, 1.7rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #f3e4c0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .btn-trailer {
    margin-top: 0.6rem;
    padding: 0.8rem 2.6rem;
    font-weight: 700;
    font-size: clamp(0.95rem, 1.4vw, 1.2rem);
    text-transform: uppercase;
    color: var(--ink);
    background:
      url("/images/portada/boton-papel.png") center / 100% 100% no-repeat,
      linear-gradient(180deg, #f0dfae, #cfae6a);
    clip-path: polygon(0% 8%, 18% 0%, 42% 6%, 70% 0%, 100% 5%, 98% 50%, 100% 95%, 75% 100%, 48% 94%, 22% 100%, 0% 94%, 2% 50%);
    transition: transform 0.2s, filter 0.2s;
  }
  .btn-trailer:hover { transform: translateY(-3px) rotate(-0.8deg); filter: brightness(1.08); }

  .explore {
    position: absolute;
    left: 2%;
    bottom: 5%;
    z-index: 3;
    padding: 0.9rem 1.8rem;
    font-size: clamp(0.9rem, 1.4vw, 1.25rem);
    text-transform: uppercase;
    color: #f5ead0;
    background: rgba(8, 10, 16, 0.92);
    border: 2px solid #c9b48a;
    transition: background 0.2s, color 0.2s;
  }
  .explore:hover { background: var(--paper); color: var(--ink); }

  /* ---------- Tarjetas ---------- */
  .cards {
    position: absolute;
    right: 0.5%;
    bottom: 3%;
    width: clamp(180px, 19vw, 280px);
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    z-index: 3;
  }
  .polaroid {
    position: relative;
    display: block;
    padding: 0.7rem 0.7rem 0.4rem;
    background: #e8e5de;
    transition: translate 0.2s;
  }
  .polaroid:hover { translate: 0 -4px; }

  .ph-img {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: radial-gradient(ellipse at 70% 30%, #4a2380, #1a0b2e 70%);
  }
  .ph-img img { width: 100%; height: 100%; object-fit: cover; }

  .ph-cap {
    display: block;
    padding: 0.35rem 0 0.25rem;
    text-align: center;
    font-weight: 700;
    font-size: clamp(0.85rem, 1.2vw, 1.05rem);
    color: var(--ink);
  }

  .strip {
    position: absolute;
    width: 38%;
    height: auto;
    max-width: none;
    opacity: 0.6;
    pointer-events: none;
  }
  .strip-l { left: -9%;  top: -5%; rotate: -38deg; }
  .strip-r { right: -9%; top: -5%; rotate: 38deg; }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .stage {
      aspect-ratio: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.6rem;
      padding: 2.6rem 1.2rem 2.4rem;
    }
    .countdown, .stamp-paper, .center, .explore, .cards { position: relative; inset: auto; }
    .countdown { width: min(100%, 460px); margin: 0; }
    .center { padding-top: 0; }
    .logo img { width: min(80vw, 380px); }
    .stamp-paper { width: 120px; order: 5; }
    .explore { order: 4; }
    .cards { width: 100%; flex-direction: row; gap: 1rem; order: 3; }
    .polaroid { flex: 1; }
  }
</style>