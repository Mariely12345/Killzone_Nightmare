---
const year = new Date().getFullYear();

const socials = [
  {
    name: "YouTube",
    href: "#",
    path: "M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z",
  },
  {
    name: "Discord",
    href: "#",
    path: "M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.2.5a18 18 0 0 0-6.4 0L8.6 3a19.8 19.8 0 0 0-4.9 1.4C.6 9 0 13.5.3 18a19.9 19.9 0 0 0 6 3l.9-1.4c-.5-.2-1-.5-1.5-.8l.4-.3a14.2 14.2 0 0 0 12.2 0l.4.3c-.5.3-1 .6-1.5.8l.9 1.4a19.9 19.9 0 0 0 6-3c.4-5.2-.7-9.7-3.4-13.6zM8.5 15.3c-1.2 0-2.1-1.1-2.1-2.4s.9-2.4 2.1-2.4 2.1 1.1 2.1 2.4-.9 2.4-2.1 2.4zm7 0c-1.2 0-2.1-1.1-2.1-2.4s.9-2.4 2.1-2.4 2.1 1.1 2.1 2.4-.9 2.4-2.1 2.4z",
  },
  {
    name: "X",
    href: "#",
    path: "M18.2 2.2h3.3l-7.2 8.3 8.5 11.3h-6.7l-5.2-6.9-6 6.9H1.6l7.7-8.8L1.2 2.2H8l4.7 6.3 5.5-6.3zm-1.2 17.6h1.8L7.1 4.1H5.1l11.9 15.7z",
  },
];
---

<footer class="footer">
  <!-- La imagen es el fondo de TODO el footer: llega hasta el borde inferior -->
  <img
    class="footer-bg"
    src="/images/paper-footer.png"
    alt=""
    aria-hidden="true"
    loading="lazy"
  />

  <section class="cta" aria-labelledby="cta-title">
    <h2 id="cta-title">¿Listo para el desafío?</h2>
    <p>Únete a la comunidad y sé parte de Killzone Nightmare.</p>
    <a href="/descargar" class="btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/>
      </svg>
      Descargar Ahora
    </a>
  </section>

  <div class="bottom">
    <div class="brand">
      <a href="/" aria-label="Killzone Nightmare - Inicio">
        <img src="/images/logo.png" alt="OSMAC Games" width="140" height="56" />
      </a>
      <p class="copy">© {year} Killzone Nightmare.</p>
    </div>

    <div class="socials">
      {socials.map((s) => (
        <a href={s.href} aria-label={s.name} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={s.path} />
          </svg>
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer {
    /* Alto del footer completo. Súbelo si quieres el papel más alto. */
    --footer-height: clamp(400px, 30vw, 600px);
    /* Zona del hueco morado donde va el CTA */
    --cta-top: 64%;
    --cta-bottom: 16%;

    position: relative;
    width: 100%;
    height: var(--footer-height);
    margin-top: 3rem;
    margin-bottom: 0;          /* nada de espacio debajo */
    color: #f3e8ff;
    overflow: hidden;          /* evita cualquier hueco o scroll lateral */
  }

  .footer-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;            /* quita el hueco de línea bajo la imagen */
    object-fit: fill;          /* ocupa todo el ancho y todo el alto */
    object-position: center bottom;
    pointer-events: none;
    user-select: none;
  }

  /* ---------- CTA dentro del papel morado ---------- */
  .cta {
    position: absolute;
    inset: var(--cta-top) 8% var(--cta-bottom);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
  }
  .cta h2 {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(1.6rem, 3.1vw, 2.8rem);
    line-height: 1.1;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }
  .cta p {
    margin: 0 0 0.6rem;
    font-size: clamp(0.9rem, 1.3vw, 1.15rem);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 2rem;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    background: var(--purple-dark, #2a0f4a);
    border: 2px solid var(--purple-light, #b88cf0);
    border-radius: 6px;
    transition: transform 0.2s, background 0.2s;
  }
  .btn:hover { background: #3d1a66; transform: translateY(-2px); }
  .btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .btn svg { width: 20px; height: 20px; }

  /* ---------- Logo, copyright y redes sobre el papel ---------- */
  .bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 clamp(1.5rem, 6vw, 6rem) clamp(0.8rem, 1.6vw, 1.6rem);
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 28vw;           /* se queda en la zona oscura de la izquierda */
  }
  .brand img {
    display: block;
    height: clamp(40px, 4.2vw, 60px);
    width: auto;
  }
  .copy {
    margin: 0;
    font-size: clamp(0.7rem, 0.85vw, 0.85rem);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  }

  .socials { display: flex; gap: 1rem; }
  .socials a {
    color: inherit;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.7));
    transition: color 0.2s, transform 0.2s;
  }
  .socials a:hover { color: var(--purple-light, #b88cf0); transform: translateY(-2px); }
  .socials a:focus-visible { outline: 2px solid #fff; outline-offset: 3px; border-radius: 3px; }
  .socials svg { display: block; width: clamp(24px, 2.2vw, 30px); height: clamp(24px, 2.2vw, 30px); }

  /* ---------- Móvil ---------- */
  @media (max-width: 700px) {
    .footer {
      --footer-height: 480px;
      --cta-top: 30%;
      --cta-bottom: 34%;
    }
    .footer-bg { object-fit: cover; }   /* sin deformar en pantallas angostas */
    .cta { inset: var(--cta-top) 6% var(--cta-bottom); }
    .bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.6rem;
    }
    .brand { align-items: center; max-width: 90%; }
  }
</style>