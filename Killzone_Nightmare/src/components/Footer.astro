---
const year = new Date().getFullYear();
---

<footer class="footer">
  <section class="cta">
    <h2>¿Listo para el desafío?</h2>
    <p>Únete a la comunidad y sé parte de Killzone Nightmare.</p>
    <a href="/descargar" class="btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/>
      </svg>
      Descargar Ahora
    </a>
  </section>

  <div class="bottom">
    <a href="/" aria-label="Killzone Nightmare - Inicio">
      <img src="/images/logo.png" alt="Killzone Nightmare" width="140" height="56" />
    </a>

    <p class="copy">© {year} Killzone Nightmare. Proyecto universitario.</p>

    <div class="socials">
      <a href="#" aria-label="YouTube" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>
      </a>
      <a href="#" aria-label="Discord" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.2.5a18 18 0 0 0-6.4 0L8.6 3a19.8 19.8 0 0 0-4.9 1.4C.6 9 0 13.5.3 18a19.9 19.9 0 0 0 6 3l.9-1.4c-.5-.2-1-.5-1.5-.8l.4-.3a14.2 14.2 0 0 0 12.2 0l.4.3c-.5.3-1 .6-1.5.8l.9 1.4a19.9 19.9 0 0 0 6-3c.4-5.200-.7-9.700-3.400-13.600zM8.500 15.300c-1.200 0-2.100-1.100-2.100-2.400s.9-2.400 2.100-2.400 2.100 1.100 2.100 2.400-.9 2.400-2.100 2.400zm7 0c-1.200 0-2.100-1.100-2.100-2.400s.9-2.400 2.100-2.400 2.100 1.100 2.100 2.400-.9 2.400-2.100 2.400z"/></svg>
      </a>
      <a href="#" aria-label="X" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.200 2.200h3.300l-7.200 8.300 8.500 11.300h-6.700l-5.200-6.900-6 6.900H1.600l7.700-8.800L1.200 2.200H8l4.700 6.300 5.500-6.300zm-1.200 17.600h1.800L7.100 4.100H5.100l11.900 15.700z"/></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 3rem;
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.45));
    padding-top: 2rem;
  }

  .cta {
    width: min(760px, 92%);
    margin: 0 auto;
    padding: 2.2rem 2rem;
    text-align: center;
    color: #f3e8ff;
    background-color: var(--purple);
    /* Cuando tengas la imagen morada rasgada, descomenta: */
    /* background-image: url("/images/paper-footer.png");
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-color: transparent; */
    border-radius: 8px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
  }
  .cta h2 {
    font-family: var(--font-title);
    font-size: 2.4rem;
    margin-bottom: 0.4rem;
  }
  .cta p { margin-bottom: 1.2rem; opacity: 0.9; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 2rem;
    font-weight: 700;
    color: #fff;
    background: var(--purple-dark);
    border: 2px solid var(--purple-light);
    border-radius: 6px;
    transition: transform 0.2s, background 0.2s;
  }
  .btn:hover { background: #3d1a66; transform: translateY(-2px); }
  .btn svg { width: 20px; height: 20px; }

  .bottom {
    width: min(1200px, 94%);
    margin: 2rem auto 0;
    padding: 1.2rem 0 1.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    color: #f3e8ff;
  }
  .bottom img { height: 52px; width: auto; }
  .copy { font-size: 0.85rem; opacity: 0.75; }

  .socials { display: flex; gap: 1rem; }
  .socials a { transition: color 0.2s, transform 0.2s; }
  .socials a:hover { color: var(--purple-light); transform: translateY(-2px); }
  .socials svg { width: 28px; height: 28px; }

  @media (max-width: 700px) {
    .bottom { flex-direction: column; text-align: center; }
  }
</style>